# Canonical runtime identity
WORKRATE_ENV=production
WORKRATE_STORAGE_ENV=production
WORKRATE_PUBLIC_URL=https://YOUR-PRODUCTION-DOMAIN

# Standard PostgreSQL (external provider)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Standard Google Cloud Storage (external provider)
WORKRATE_STORAGE_BACKEND=gcs
GCS_PROJECT_ID=YOUR-GCP-PROJECT
GCS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
WORKRATE_STORAGE_BUCKET=YOUR-BUCKET
WORKRATE_STORAGE_PRIVATE_ROOT=YOUR-BUCKET/.private
WORKRATE_STORAGE_PUBLIC_ROOTS=YOUR-BUCKET/public
WORKRATE_EXPECTED_STORAGE_BUCKET_FINGERPRINT=COMPUTE_WITH_SCRIPT

# Existing application secrets remain required as applicable.
# Do not place real secret values in source control.
